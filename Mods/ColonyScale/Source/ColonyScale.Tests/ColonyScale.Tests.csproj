<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checker for the update pipeline: loads the real game assemblies in plain .NET,
       resolves every patch target, runs transpilers, applies patches, compares IL fingerprints. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0618;MSB3277;NU1701;NU1903</NoWarn>
    <RimWorldDir Condition="'$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'RimWorldWin64_Data/Managed/Assembly-CSharp.dll'))</RimWorldDir>
    <ManagedDir>$(RimWorldDir)/RimWorldWin64_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- obj/ and bin/ hold generated AssemblyInfo; globbing them in duplicates every assembly attribute. -->
    <Compile Include="../ColonyScale/**/*.cs" Exclude="../ColonyScale/obj/**/*.cs;../ColonyScale/bin/**/*.cs" LinkBase="ColonyScale" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
