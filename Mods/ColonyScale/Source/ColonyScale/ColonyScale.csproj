<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ColonyScale</AssemblyName>
    <RootNamespace>ColonyScale</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin/Release</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The game install: RIMWORLD_DIR, else the nearest ancestor folder that holds the game's managed DLLs
         (the repo is overlaid on a RimWorld install, so this also resolves from git worktrees nested inside it). -->
    <RimWorldDir Condition="'$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'RimWorldWin64_Data/Managed/Assembly-CSharp.dll'))</RimWorldDir>
    <ManagedDir>$(RimWorldDir)/RimWorldWin64_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: at runtime the Harmony mod (brrainz.harmony) provides 0Harmony.dll. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)/ColonyScale.dll" DestinationFolder="$(ProjectDir)../../Assemblies/" />
  </Target>
</Project>
