<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checker for the update pipeline: loads the real game assemblies in plain .NET,
       resolves every patch target, runs transpilers, applies patches, compares IL fingerprints. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0618;MSB3277;NU1701;NU1903</NoWarn>
    <RimWorldDir Condition="'$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Assembly-CSharp.dll'))</RimWorldDir>
    <RimWorldParent Condition="'$(RimWorldDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'RimWorld/Assembly-CSharp.dll'))</RimWorldParent>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RimWorldParent)' != ''">$(RimWorldParent)/RimWorld</RimWorldDir>
    <ManagedDir>$(RimWorldDir)</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- obj/ and bin/ hold generated AssemblyInfo; globbing them in duplicates every assembly attribute. -->
    <Compile Include="../ColonyScale/**/*.cs" Exclude="../ColonyScale/obj/**/*.cs;../ColonyScale/bin/**/*.cs" LinkBase="ColonyScale" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <!-- 1.7 has no Unity: the game redirects UnityEngine* to UnityStubs.dll. -->
    <Reference Include="UnityStubs"><HintPath>$(ManagedDir)/UnityStubs.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
